{
  "name": "galactic-shrine.github.io",
  "private": true,
  "version": "2.7.2",
  "description": "Portail documentaire Galactic-Shrine généré avec Eleventy.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "refresh:metadata": "node scripts/refresh-github-metadata.js",
    "build:metadata": "npm run refresh:metadata && npm run build",
    "styles": "sass src/assets/scss/site.scss src/assets/css/site.css --style=expanded --no-source-map",
    "predev": "npm run styles",
    "prebuild": "npm run styles"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "sass": "1.90.0"
  }
}
