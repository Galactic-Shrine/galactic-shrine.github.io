---
layout: layouts/base.njk
---
{% set project = projectCatalog[projectId] %}
{% set projectPages = collections.projectDocs | whereProject(projectId) | sortByOrder %}
{% set implementation = false %}
{% if project and implementationId and project.implementationCatalog %}
  {% set implementation = project.implementationCatalog[implementationId] %}
{% endif %}
<section class="page-hero">
  <div class="container">
    <div class="breadcrumbs">
      <a href="/index.html">Accueil</a><span>›</span>
      <a href="/docs/index.html">Projets</a><span>›</span>
      {% if project %}<a href="{{ project.documentation.baseUrl }}">{{ project.name }}</a><span>›</span>{% endif %}
      {% if implementation %}<a href="{{ implementation.docsUrl }}">{{ implementation.name }}</a><span>›</span>{% endif %}
      <span>{{ title }}</span>
    </div>

    <div class="kicker">Documentation projet{% if project and project.type %} • {{ project.type }}{% endif %}{% if implementation %} • {{ implementation.name }}{% endif %}</div>
    <h1 class="page-title">{{ title }}</h1>
    {% if summary %}<p class="page-intro">{{ summary }}</p>{% endif %}

    <div class="tag-list">
      {% if implementation and implementation.metadata.latestRelease %}<span class="tag">{{ implementation.metadata.latestRelease.tag }}</span>{% elif project and project.metadata.latestRelease %}<span class="tag">{{ project.metadata.latestRelease.tag }}</span>{% endif %}
      {% if implementation and implementation.metadata.defaultBranch %}<span class="tag">Branche {{ implementation.metadata.defaultBranch }}</span>{% elif project and project.metadata.defaultBranch %}<span class="tag">Branche {{ project.metadata.defaultBranch }}</span>{% endif %}
      <span class="tag">Documentation centralisée</span>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container viewer-layout">
    <aside class="sidebar-card" aria-label="Navigation de la documentation">
      {% set tocItems = content | extractHeadings %}
      {% if tocItems.length %}
        <div class="eyebrow">Sommaire</div>
        <ul class="toc-list">
          {% for heading in tocItems %}
            <li class="lvl-{{ heading.level }}"><a href="#{{ heading.id }}">{{ heading.text | safe }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}

      <div class="eyebrow"{% if tocItems.length %} style="margin-top:1rem;"{% endif %}>Dans ce projet</div>
      <nav>
        {% for item in projectPages %}
          {% if not item.data.implementationId %}
            <a{% if item.url == page.url %} class="active" aria-current="page"{% endif %} href="{{ item.url }}">{{ item.data.navTitle or item.data.title }}</a>
          {% endif %}
        {% endfor %}

        {% if project and project.implementations %}
          {% for impl in project.implementations %}
            {% set isCurrentImplementation = implementationId == impl.id %}
            <div class="project-nav-group{% if isCurrentImplementation %} is-open{% endif %}" data-project-nav-group>
              <button
                class="project-nav-toggle"
                type="button"
                aria-expanded="{% if isCurrentImplementation %}true{% else %}false{% endif %}"
                aria-controls="project-nav-{{ impl.id }}"
                data-project-nav-toggle
              >
                <span>{{ impl.name }}</span>
                <span class="project-nav-chevron" aria-hidden="true">›</span>
              </button>

              <div
                class="project-nav-panel"
                id="project-nav-{{ impl.id }}"
                {% if not isCurrentImplementation %}inert{% endif %}
                data-project-nav-panel
              >
                <div class="project-nav-panel-inner">
                  {% for item in projectPages %}
                    {% if item.data.implementationId == impl.id %}
                      <a{% if item.url == page.url %} class="active" aria-current="page"{% endif %} href="{{ item.url }}">{{ item.data.navTitle or item.data.title }}</a>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </nav>
    </aside>

    <article class="viewer-shell">
      <div class="viewer-header">
        <div>
          <div class="eyebrow">Source documentaire</div>
          <div class="quick-links">
            <a class="button small" href="/search/index.html">Recherche globale</a>
            {% if implementation and implementation.repository %}
              <a class="button small github-button" href="https://github.com/{{ implementation.repository.owner }}/{{ implementation.repository.repo }}" target="_blank" rel="noreferrer" title="Ouvrir le dépôt GitHub" aria-label="Ouvrir le dépôt GitHub de {{ implementation.name }}">
              <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.32c.98 0 1.96.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.4-5.29 5.69.42.36.79 1.06.79 2.14v3.05c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"/>
              </svg>
            </a>
            {% elif project and project.repository %}
              <a class="button small github-button" href="https://github.com/{{ project.repository.owner }}/{{ project.repository.repo }}" target="_blank" rel="noreferrer" title="Ouvrir le dépôt GitHub" aria-label="Ouvrir le dépôt GitHub de {{ project.name }}">
              <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.32c.98 0 1.96.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.4-5.29 5.69.42.36.79 1.06.79 2.14v3.05c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"/>
              </svg>
            </a>
            {% endif %}
          </div>
        </div>
        <div class="tag-list">
          {% if project %}<span class="tag">{{ project.name }}</span>{% endif %}
          {% if implementation %}<span class="tag">{{ implementation.name }}</span>{% endif %}
          {% if implementation and implementation.metadata.refreshedAt %}<span class="tag">Métadonnées API</span>{% elif project and project.metadata.refreshedAt %}<span class="tag">Métadonnées API</span>{% endif %}
        </div>
      </div>

      <div class="viewer-body">
        {{ content | safe }}
      </div>
    </article>
  </div>
</section>
